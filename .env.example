# --- Database ---
# MongoDB Atlas / local Mongo. Use "mongomock://" for an in-memory demo DB (not persistent).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=repcheck

# --- LLM (Gemma via Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Auth (MVP: one coach account) ---
COACH_PASSWORD=change-me
COOKIE_SECURE=false

# --- URLs ---
FRONTEND_URL=http://localhost:3000
# Used by the Next.js server to proxy /api/* to the backend
BACKEND_URL=http://localhost:8000

# --- Uploads ---
MAX_UPLOAD_MB=100
UPLOAD_DIR=uploads

# --- Optional ---
ELEVENLABS_API_KEY=
# "Sarah" (default voice; older library voices like Rachel need a paid plan on the API)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Seed 3 demo clients at startup (handy with MONGODB_URI=mongomock://)
DEMO_SEED_ON_START=false
